# Copy to .env (ignored by Git) and fill in only what you use. No secrets belong in this file.
# The app loads nothing from .env by itself; export these in your shell or IDE run config.

# Run every agent on its deterministic local implementation (no model, no network).
VMI_OFFLINE=1

# A new room starts on a random match. Set VMI_DEMO=1 before recording the demo: every new room
# then plays the demo match (VMI_DEMO_SEED, default 2) and its analyses are pre-written at startup.
# /tv?demo loads the demo match for one room without restarting.
VMI_DEMO=0
VMI_DEMO_SEED=2
# Pre-write the demo analyses: defaults to on in demo mode, off otherwise.
VMI_WARM_DEMO=0

# Atmosphere mode: combined (80% crowd + 20% detected attack) or crowd_only (declared and labelled).
VMI_ATMOSPHERE_MODE=combined

# Microsoft Foundry: only after D2-00 approves a zero-cost path. Keyless (Entra ID): no API key here.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# Application Insights connection string, only for an approved deployment. Leave empty locally.
APPLICATIONINSIGHTS_CONNECTION_STRING=
